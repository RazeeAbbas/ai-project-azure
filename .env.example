# AI Knowledge Copilot — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ─── Application ───────────────────────────────────────────
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Azure OpenAI ──────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ─── Database (Azure PostgreSQL Flexible Server) ────────────
DATABASE_URL=postgresql://copilotadmin:YOUR_PASSWORD@YOUR_HOST:5432/aikcopilot
DATABASE_HOST=YOUR_HOST.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=aikcopilot
DATABASE_USERNAME=copilotadmin
DATABASE_PASSWORD=YOUR_PASSWORD

# ─── Azure AI Search (Vector Store) ────────────────────────
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH_SERVICE.search.windows.net
AZURE_SEARCH_KEY=YOUR_SEARCH_ADMIN_KEY
AZURE_SEARCH_INDEX=kicopilot-index

# ─── Azure Blob Storage ─────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=YOUR_STORAGE_ACCOUNT
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=documents

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ─── Azure Application Insights ────────────────────────────
AZURE_MONITORING_INSTRUMENTATION_KEY=YOUR_INSTRUMENTATION_KEY
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=YOUR_KEY;...

# ─── RAG Parameters ────────────────────────────────────────
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
RAG_MAX_CONTEXT_TOKENS=2000
RAG_TEMPERATURE=0.3
ENABLE_FALLBACK_RESPONSE=true

# ─── Feature Flags ─────────────────────────────────────────
ENABLE_RAG=true
ENABLE_DOCUMENT_UPLOAD=true
ENABLE_CHAT=true
ENABLE_METRICS=true

# ─── Build Metadata (set by CI/CD) ─────────────────────────
BUILD_VERSION=dev
BUILD_COMMIT=local
BUILD_TIMESTAMP=
